# Copy to .env on the Pi (chmod 600). Never commit .env.

# Host names / IPs the phone uses to reach the Pi (first one goes in pairing QR codes).
# Add the Pi's home-LAN IP and hostname.local so both networks work.
RS_PUBLIC_HOSTS=10.42.0.1,raspberrypi.local
RS_PORT=8090

# Allow unpaired browsers on the network to see the pairing QR (default 0:
# only the Pi's own screen, the SSH CLI, or an already-paired phone can).
RS_PAIRING_FROM_NETWORK=0

# Optional Wi-Fi QR so the phone can join the Pi's hotspot first
RS_WIFI_SSID=
RS_WIFI_PASSWORD=

# Local LLM (llama-server, OpenAI-compatible)
RS_LLM_URL=http://127.0.0.1:8081/v1
RS_LLM_MAX_TOKENS=400
RS_LLM_TIMEOUT=150

# OCR
RS_OCR_THREADS=2
RS_OCR_MAX_SIDE=1600
# Fast model for every receipt; hard/faded ones get an automatic second pass
# with the medium recogniser (fetch once: .venv/bin/python scripts/fetch_models.py rec)
RS_OCR_DET=small
RS_OCR_REC=small
RS_OCR_RETRY_REC=medium

# Email (Gmail: create an App Password at myaccount.google.com/apppasswords)
RS_SMTP_HOST=smtp.gmail.com
RS_SMTP_PORT=587
RS_SMTP_USER=
RS_SMTP_PASSWORD=
RS_SMTP_FROM=
RS_EMAIL_MAX_BYTES=20971520
